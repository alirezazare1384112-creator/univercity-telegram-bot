{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && mkdir -p ../public && cp -r dist/. ../public/",
  "framework": null,
  "builds": [
    {
      "src": "requirements.txt",
      "use": "@vercel/python",
      "config": { "includeFiles": ["app/**", "alembic.ini"] }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api/ping.py" },
    { "src": "/api/((?!ping).*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
