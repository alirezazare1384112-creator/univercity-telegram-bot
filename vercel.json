{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && mkdir -p ../public && cp -r dist/. ../public/",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "app/**"
    }
  },
  "rewrites": [
    { "source": "/api/((?!ping).*)", "destination": "/api/index/$1" }
  ]
}
