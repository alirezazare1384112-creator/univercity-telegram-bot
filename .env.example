# ---------------------------------------------------------------
# Student Assistant Bot - environment configuration
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file to Git.
# ---------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Database.
# Development (default):  sqlite:///./data/bot.db
# Production  (PostgreSQL): postgresql://USER:PASSWORD@HOST:5432/DBNAME
# The application converts these to async drivers automatically.
DATABASE_URL=sqlite:///./data/bot.db

# URL of the external GPA calculator website (no local GPA calculation).
GPA_CALCULATOR_URL=https://example.com/gpa

# Comma separated Telegram user ids allowed to use the admin panel.
ADMIN_IDS=

# Bot timezone used to display / parse dates and reminder times.
TIMEZONE=Asia/Tehran

# Eitaa channels whose public pages are polled for new announcements.
# Comma separated; leave empty to disable the automatic import.
EITAA_SYNC_URLS=https://eitaa.com/atriardakani,https://eitaa.com/ArdakanUni_Resaneh
# Seconds between two checks of the channel pages (minimum 60, default 300).
EITAA_SYNC_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Telegram Mini App ---
# Public HTTPS URL registered as the WebApp (set it in BotFather too).
WEBAPP_URL=
# Where the Mini App API listens (same process as the bot).
API_HOST=127.0.0.1
API_PORT=8000
# How long a Telegram initData login stays valid (seconds, default 86400).
WEBAPP_AUTH_MAX_AGE=86400
